<UserControl x:Class="OptimizerWpf.Views.RecoveryCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tr="clr-namespace:OptimizerWpf"
             xmlns:views="clr-namespace:OptimizerWpf.Views"
             mc:Ignorable="d">
    <!-- Σημεία επαναφοράς + System Image Backup - μετακινήθηκαν από την καρτέλα Σύστημα στην Υγεία (6.1.0). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
            <!-- Σημεία Επαναφοράς -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Shield" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr System_RestorePoints}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{tr:Tr System_CreatePoint}" Style="{StaticResource AccentButtonStyle}" Width="220" Height="40" Margin="0,0,10,0" Click="BtnCreateRestorePoint_Click"/>
                        <Button Content="{tr:Tr Refresh}" Style="{StaticResource FlatButtonStyle}" Width="150" Height="40" Margin="0,0,10,0" Click="BtnRefreshRestorePoints_Click"/>
                        <Button Content="{tr:Tr System_OpenProtectionSettings}" Style="{StaticResource FlatButtonStyle}" Width="230" Height="40" Click="BtnOpenProtectionSettings_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtRestorePointsStatus" Text="" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ListRestorePoints">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CreationTime}" Style="{StaticResource SubTextStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{tr:Tr System_RestoreAction}" Style="{StaticResource FlatButtonStyle}" Click="BtnRestoreToPoint_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ΝΕΟ - roadmap "Backup/imaging" - GUI wrapper γύρω από το ενσωματωμένο wbadmin.exe
                 των Windows, βλ. BackupService.cs για λεπτομέρειες scope. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Shield" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr Backup_Title}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr Backup_Desc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid x:Name="BackupControls" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ListBackupTargetDrives" Grid.Column="0" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="{tr:Tr Backup_StartButton}" Style="{StaticResource AccentButtonStyle}" Padding="16,8" MinWidth="280" Margin="0,0,8,0" Click="BtnStartBackup_Click"/>
                        <Button Grid.Column="2" Content="{tr:Tr Backup_ViewVersionsButton}" Style="{StaticResource FlatButtonStyle}" Padding="16,8" MinWidth="300" Click="BtnViewBackupVersions_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Windows RE" Style="{StaticResource FlatButtonStyle}" Margin="0,0,8,0"
                                Click="BtnWindowsRecoveryGuide_Click"/>
                        <Button Content="Clonezilla Live" Style="{StaticResource FlatButtonStyle}"
                                Click="BtnDiskCloneGuide_Click"/>
                        <Button Content="Offline clone kit (expert)" ToolTip="Exports ZIP for independently booted Linux Live, not a Windows clone action"
                                Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0" Click="BtnExportOfflineClone_Click"/>
                        <Button Content="Windows RE status" ToolTip="Read-only recovery environment status"
                                Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0" Click="BtnCheckWindowsRe_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtBackupStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ListBackupVersions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource SubTextStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>


            <!-- 7.0.0: below System Image Backup in System > Tools -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="TxtTransferTitle" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtTransferHelp" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTransferFrom" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnChooseFrom" Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Padding="12,8" Click="ChooseTransferFrom_Click"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTransferTo" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnChooseTo" Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Padding="12,8" Click="ChooseTransferTo_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="BtnTransferCheck" Style="{StaticResource AccentButtonStyle}" Padding="12,8"
                                Margin="0,0,8,8" Click="CheckTransfer_Click"/>
                        <Button x:Name="BtnAppsExport" Style="{StaticResource FlatButtonStyle}" Padding="12,8"
                                Margin="0,0,0,8" Click="ExportApps_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtTransferStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtAppsExportStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
    </StackPanel>
</UserControl>
